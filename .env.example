# Iron Trainer (backend-v2 / Quarkus). Copy to .env and fill in.
#
# Every var here is read by backend-v2/src/main/resources/application.properties.
# NOTE: a ${VAR:default} default applies only when the var is ABSENT — setting it
# to an empty string overrides the default with empty.

# ── Strava API (https://www.strava.com/settings/api) ──────────────────────────
# Create an application; set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8080/api/strava/callback

# ── WHOOP API (https://developer-dashboard.whoop.com/) ────────────────────────
# Optional. Leave BOTH blank and the WHOOP API integration stays off entirely —
# no Connect button, no daily job — and the export-ZIP upload still works.
# The redirect URI must match the dashboard entry character for character.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/api/whoop/callback
# Daily catch-up sync. Set to "off" to disable (sensible for a self-hoster who
# only ever uploads the export ZIP).
WHOOP_SYNC_CRON=0 0 10 * * ?

# ── Claude API (https://console.anthropic.com/) ───────────────────────────────
# Optional. Without it the AI features fall back to the deterministic planner
# and nothing is sent anywhere.
ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Dev/test need NOTHING here: Quarkus Dev Services starts a throwaway Postgres
# in Docker automatically. These three are for %prod only.
#   DATABASE_JDBC_URL=jdbc:postgresql://HOST.pooler.supabase.com:5432/postgres?sslmode=require
#   DATABASE_USERNAME=postgres.PROJECT_REF
#   DATABASE_PASSWORD=
DATABASE_JDBC_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ── App ───────────────────────────────────────────────────────────────────────
# Race target (defaults baked in; override here if needed).
RACE_NAME=IRONMAN 70.3 New York
RACE_DATE=2026-09-26
# Comma-separated origins allowed to call the API. Also where OAuth callbacks
# bounce back to, so a wrong value sends a successful connect to the wrong host.
CORS_ORIGINS=http://localhost:5173
# Ignore activities older than this many years (0 = keep everything). Also bounds
# how far back a WHOOP full re-sync walks.
HISTORY_YEARS=5

# ── Multi-user auth ───────────────────────────────────────────────────────────
# Off by default → local single-user, no login. Turn on for a deployment.
AUTH_REQUIRED=false
# Required when AUTH_REQUIRED=true. Use a long random string.
SESSION_SECRET=dev-insecure-change-me
# Comma-separated Strava athlete ids allowed to log in (empty = allow anyone).
ALLOWED_STRAVA_IDS=
# Set true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
# Admin console password (leave blank to disable the console).
ADMIN_PASSWORD=
